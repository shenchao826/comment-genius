# Teachers (评语助手) 后端环境变量配置
# 用于 Cloudflare Pages Functions / Workers

# AI API 配置（通义千问 Qwen）
QWEN_API_KEY=your_qwen_api_key

# JWT 认证配置
JWT_SECRET=your_jwt_secret_minimum_32_chars

# D1 数据库（已在 wrangler.toml 中配置）
# DB: RAG_DB

# 虎皮椒微信支付
HUPIJIAO_APP_ID=your_hupijiao_app_id
HUPIJIAO_APP_SECRET=your_hupijiao_app_secret
HUPIJIAO_NOTIFY_URL=https://teachers.minicode.cloud/api/payment/callback

# 管理员 Token（可选）
ADMIN_TOKEN=your_admin_token

# 内部API密钥（用于服务端间调用鉴权，如邀请奖励发放等）
INTERNAL_API_SECRET=your_internal_api_secret_here

# 企业微信 Webhook（可选，用于每日运营报告推送）
# 在企业微信群中添加"机器人"，获取 Webhook 地址
WECOM_WEBHOOK_URL=
