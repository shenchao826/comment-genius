# ============================================
# 评语助手 (Teachers) 环境变量配置
# ============================================
# 复制此文件为 .env 并填入真实值
# 命令: cp .env.example .env

# ----------------------------------------
# 🌐 应用基础配置
# ----------------------------------------

# 环境标识 (development | staging | production)
VITE_APP_ENV=development

# 应用标题
VITE_APP_TITLE=评语助手 - AI赋能每一位教师

# API 基础地址（本地开发用）
VITE_API_BASE_URL=http://localhost:8787/api

# RAG 服务地址（如果使用外部 AI 服务）
VITE_RAG_API_URL=http://localhost:8787


# ----------------------------------------
# 🔐 认证与安全
# ----------------------------------------

# JWT 密钥（用于签名 token，请使用强随机字符串）
# 生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Token 过期时间（小时）
JWT_EXPIRES_IN=168h  # 7天

# 管理员令牌（用于访问管理后台）
ADMIN_TOKEN=admin-token-change-this


# ----------------------------------------
# 🤖 AI 服务配置（通义千问）
# ----------------------------------------

# 通义千问 API Key
# 获取地址: https://dashscope.console.aliyun.com/
QWEN_API_KEY=sk-your-qwen-api-key-here

# AI 模型选择 (qwen-turbo | qwen-plus | qwen-max)
QWEN_MODEL=qwen-turbo

# 最大生成 token 数
QWEN_MAX_TOKENS=2000

# 温度参数（0.0-2.0，越高越有创意）
QWEN_TEMPERATURE=0.7


# ----------------------------------------
# 💳 支付配置（虎皮椒支付）
# ----------------------------------------

# 商户应用 ID
HUPIJIAO_APP_ID=your-hupijiao-app-id

# 商户应用密钥
HUPIJIAO_APP_SECRET=your-hupijiao-app-secret

# 支付成功回调通知地址
HUPIJIAO_NOTIFY_URL=https://teachers.minicode.cloud/api/payment/callback

# 支付跳转返回地址
HUPIJIAO_RETURN_URL=https://teachers.minicode.cloud/membership?payment=success


# ----------------------------------------
# 📊 数据库配置（Cloudflare D1）
# ----------------------------------------

# D1 数据库 ID（自动创建或手动指定）
# 通过 wrangler d1 create teachers-db 获取
DATABASE_ID=your-d1-database-id

# 数据库预览 URL（可选，用于调试）
DATABASE_PREVIEW_URL=https://console.cloudflare.com/


# ----------------------------------------
# 📈 监控与日志（可选）
# ----------------------------------------

# Sentry 错误监控 DSN（可选）
# 获取地址: https://sentry.io/
SENTRY_DSN=

# Sentry 环境
SENTRY_ENVIRONMENT=development

# 日志级别 (debug | info | warn | error)
LOG_LEVEL=info


# ----------------------------------------
# 🔔 其他服务（可选）
# ----------------------------------------

# Supabase 配置（如果使用 Supabase 作为 BaaS）
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal.me 用户名（可选，用于捐赠按钮）
PAYPAL_ME_USERNAME=

# Redis/Upstash 配置（用于缓存和限流，生产环境推荐）
REDIS_URL=
REDIS_TOKEN=


# ----------------------------------------
# ⚙️ 功能开关
# ----------------------------------------

# 是否启用注册功能 (true | false)
ENABLE_REGISTRATION=true

# 是否启用试用功能（新用户7天免费）
ENABLE_TRIAL=true

# 试用期天数
TRIAL_PERIOD_DAYS=7

# 免费用户每日限额
FREE_USER_DAILY_QUOTA=5

# 登录用户每日限额
LOGIN_USER_DAILY_QUOTA=20

# 专业版用户每日限额（-1 表示无限）
PREMIUM_DAILY_QUOTA=-1


# ----------------------------------------
# 🎨 UI 配置
# ----------------------------------------

# 默认评语风格 (gentle | formal | humorous | objective | warm)
DEFAULT_STYLE=gentle

# 默认评语长度 (concise | standard | detailed)
DEFAULT_LENGTH=standard

# 每页显示条数
PAGE_SIZE=20


# ============================================
# 💡 开发提示
# ============================================

# 1. 首次运行前请确保已安装依赖:
#    npm install

# 2. 初始化数据库:
#    npx wrangler d1 execute teachers-db --file=./database/schema.sql --local

# 3. 本地开发启动:
#    npm run dev

# 4. 部署到 Cloudflare Pages:
#    npm run deploy

# ============================================
